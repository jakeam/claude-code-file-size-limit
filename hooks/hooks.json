{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/file-size-limit.sh after-edit",
            "statusMessage": "Checking the edited file is under 5,000 tokens"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/file-size-limit.sh before-commit",
            "statusMessage": "Checking no changed file is over 5,000 tokens"
          }
        ]
      }
    ]
  }
}
